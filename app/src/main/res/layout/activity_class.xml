<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 위쪽: 왼쪽 과목정보, 오른쪽 LIVE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 과목명 + 주차·시간 두줄 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCourseName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="과목 이름"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCourseInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0주차"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvSchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="수요일 00:00-00:00"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- LIVE 분홍 알약모양 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/liveBg"
                app:cardCornerRadius="50dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="● LIVE"
                    android:textColor="@color/live"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/line" />

        <!-- 오늘의 주제. 주제 없으면 자바에서 이 묶음을 통째로 숨김 -->
        <LinearLayout
            android:id="@+id/topicBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘의 주제"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTopic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="수업 주제"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 원 가운데 오게 위아래 빈칸 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 갸웃 버튼. 바깥링 -> 안쪽링 -> 노란원 순서로 겹쳐놓음 -->
        <FrameLayout
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="center_horizontal">

            <!-- 바깥 링. 평소엔 꽉 차있고 누르면 시계방향으로 줄어듦 -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/ringOuter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:max="1000"
                android:progress="1000"
                app:indicatorSize="320dp"
                app:trackThickness="24dp"
                app:indicatorColor="@color/gyautGlow"
                app:trackColor="@android:color/transparent"
                app:indicatorDirectionCircular="counterclockwise"
                app:trackCornerRadius="0dp"
                app:indicatorTrackGapSize="0dp" />

            <!-- 안쪽 링 -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/ringTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:max="1000"
                android:progress="1000"
                app:indicatorSize="272dp"
                app:trackThickness="16dp"
                app:indicatorColor="@color/gyautRing"
                app:trackColor="@android:color/transparent"
                app:indicatorDirectionCircular="counterclockwise"
                app:trackCornerRadius="0dp"
                app:indicatorTrackGapSize="0dp" />

            <!-- 가운데 원 (실제로 누르는 부분) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGyaut"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="120dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <!-- 그라데이션은 여기 배경으로 깔림 -->
                <LinearLayout
                    android:id="@+id/gyautFace"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_gyaut_normal"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:text="\?"
                        android:textColor="@color/onPrimary"
                        android:textSize="88sp" />

                    <TextView
                        android:id="@+id/tvGyautTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="갸웃"
                        android:textColor="@color/onPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 지금 갸웃 누른 사람 수. 숫자는 나중에 자바로 바꿈 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGyautCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0명"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이 함께 궁금해하고 있어요"
                android:textColor="@color/text2"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 익명 질문 작성 (노랑) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWrite"
            style="@style/Widget.Gyaut.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="익명 질문 작성"/>

        <!-- 오늘의 질문 보기 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuestions"
            style="@style/Widget.Gyaut.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="오늘의 질문 보기"
            android:textStyle="bold"
            app:backgroundTint="@color/surface" />

    </LinearLayout>
</LinearLayout>