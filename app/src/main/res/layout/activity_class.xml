<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 과목이름이랑 LIVE 한줄에 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCourseName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="과목 이름"
                android:textColor="@color/text2"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● LIVE"
                android:textColor="@color/live"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="수업 주제"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 원 가운데 오게 위아래 빈칸 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 갸웃 버튼. 바깥링 -> 안쪽링 -> 노란원 순서로 겹쳐놓음 -->
        <FrameLayout
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center_horizontal">

            <!-- 바깥 큰 링. 안쪽 링이랑 같이 줄어듦 -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/ringOuter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:max="100"
                android:progress="0"
                app:indicatorSize="300dp"
                app:trackThickness="22dp"
                app:indicatorColor="@color/gyautGlowFill"
                app:trackColor="@color/gyautGlow"
                app:indicatorTrackGapSize="0dp" />

            <!-- 안쪽 링. 누르면 100 -> 0 으로 줄어들게 할 예정 -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/ringTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:max="100"
                android:progress="0"
                app:indicatorSize="256dp"
                app:trackThickness="14dp"
                app:indicatorColor="@color/primary"
                app:trackColor="@color/gyautRing"
                app:indicatorTrackGapSize="0dp" />

            <!-- 노란 원 (실제로 누르는 부분) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGyaut"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="110dp"
                app:cardBackgroundColor="@color/primary"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="\?"
                        android:textColor="@color/onPrimary"
                        android:textSize="80sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGyautTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="갸웃"
                        android:textColor="@color/onPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 익명 질문 작성 (노랑) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWrite"
            style="@style/Widget.Gyaut.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="익명 질문 작성" />

        <!-- 오늘의 질문 보기 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuestions"
            style="@style/Widget.Gyaut.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="오늘의 질문 보기"
            android:textStyle="bold"
            app:backgroundTint="@color/surface" />

    </LinearLayout>
</LinearLayout>